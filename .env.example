# Copy to .env and fill in during the FINISH phase.
# With NOTHING filled in, the site runs in MOCK mode (sample listings). That's expected.

# --- Company / branding ---
COMPANY_NAME="CORE Spaces"
COMPANY_TAGLINE="Dubai property, brokered properly."
COMPANY_PHONE="+971 56 313 8010"
COMPANY_EMAIL="najam@corespaces.info"
COMPANY_ADDRESS="Business Bay, Dubai, UAE"

# --- Agents ---
# Normally leave this EMPTY. Each property shows the agent handling it, and the
# site reads that agent's number straight from their Zoho profile:
#   Zoho -> Setup -> Users -> the agent -> Phone (or Mobile)
# Fill that in once per agent and the website follows automatically.
#
# Use this only as a fallback for an agent whose Zoho profile has no number.
# Key on the agent's Zoho display name or their login email; separate with ";".
#   AGENTS="Francis Ahovi:+971501112222;cophy8080@gmail.com:+971503334444"
AGENTS=""

# --- Behaviour ---
# Seconds to reuse fetched listings before asking the live source again.
LISTINGS_CACHE_TTL="90"
# Show the built-in SAMPLE listings if the live source fails on a cold start?
# They contain invented properties and phone numbers — leave off in production.
SHOW_SAMPLES_ON_FAILURE=""
# Enables /debug/zoho?key=<value>. Leave blank to switch diagnostics off.
DEBUG_KEY=""

# --- Supabase (cache + image bucket + leads) ---
# Settings -> API. Use the SERVICE ROLE key (server-side only, keep secret).
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_BUCKET="listing-photos"

# --- Zoho CRM ---  (see zoho/oauth_setup.md)
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
# Data centre hosts (UAE is usually .com — change if not):
ZOHO_ACCOUNTS_HOST="https://accounts.zoho.com"
ZOHO_API_HOST="https://www.zohoapis.com"
ZOHO_PROPERTIES_MODULE="Properties"
