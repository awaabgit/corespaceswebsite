# Copy to .env and fill in during the FINISH phase.
# With NOTHING filled in, the site runs in MOCK mode (sample listings). That's expected.

# --- Company / branding ---
COMPANY_NAME="CORE Spaces"
COMPANY_TAGLINE="Dubai property, brokered properly."
COMPANY_PHONE="+971 4 000 0000"
COMPANY_EMAIL="hello@corespaces.ae"
COMPANY_ADDRESS="Business Bay, Dubai, UAE"

# --- Supabase (cache + image bucket + leads) ---
# Settings -> API. Use the SERVICE ROLE key (server-side only, keep secret).
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_BUCKET="listing-photos"

# --- Zoho CRM ---  (see zoho/oauth_setup.md)
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
# Data centre hosts (UAE is usually .com — change if not):
ZOHO_ACCOUNTS_HOST="https://accounts.zoho.com"
ZOHO_API_HOST="https://www.zohoapis.com"
ZOHO_PROPERTIES_MODULE="Properties"
